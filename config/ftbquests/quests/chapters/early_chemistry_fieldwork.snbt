			x: -16.0d
			y: 0.0d
		}
		{
			dependencies: ["1000000000000002"]
			description: ["One carbon and one stick make four torches. The coal-measures side stream pays back immediately during exploration."]
			icon: "minecraft:torch"
			id: "1000000000000003"
			shape: "rsquare"
			tasks: [{ id: "2000000000000003" item: "minecraft:torch" type: "item" }]
