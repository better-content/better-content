  "1.18.2": {
    "1.18.2-1.0.0": "### New Features:\n+ Red Mushroom\n+ Brown Mushroom\n+ Mega Red Mushroom\n+ Mega Brown Mushroom\n+ Modified worldgen in mushroom fields and dark forests to include mushrooms",
    "1.18.2-0.1.0-Beta2": "### Changes\n- Update for DT beta 6.\n- Port vanilla cacti replacements for desert villages.",
    "1.18.2-0.1.0-Beta1": "Update to work with DT 0.11.0 Beta 1.",
    "1.18.2-0.1.0-Alpha1": "Direct port of 1.16.5 version."
  },
  "1.19.2": {
    "1.19.2-1.1.1": "- Update in-line with DT beta 5 [Harley]",
    "1.19.2-1.1.2": "- Fix mushroom registration (ported from 18f0caf87a3ba7619a41be4f11034076611fa658) [Harley]\n- Update in-line with DT beta 5 [Harley]"
  },
  "1.16.5": {
    "1.16.5-0.1.0": "New Features: - Saguaro fruit now generates in saguaro cacti - Saguaro seed item was renamed to saguaro fruit and is now edible Fixes: - Fixed non-dynamic trees generating in mesa plateaus",
