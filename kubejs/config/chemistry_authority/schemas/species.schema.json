{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://better-content.invalid/schema/bc.chemical_species.v1.json",
  "title": "Better Content canonical chemical species",
  "type": "object",
  "required": [
    "schema",
    "species"
  ],
  "properties": {
    "schema": {
      "const": "bc.chemical_species.v1"
    },
    "species": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "composition",
          "review_state"
        ]
      }
    }
  }
}
