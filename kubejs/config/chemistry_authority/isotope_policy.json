{
  "schema": "bc.isotope_state.v1",
  "scope": "loaded ChemLib matter in clouds, tanks, sealed cells, loose stacks, player inventories, block inventories, and active machine state",
  "time_basis": "server_game_time",
  "evaluation_model": "bounded_loaded_holder_continuous_microbatch_and_deterministic_stack_exposure",
  "global_scans_allowed": false,
  "canonical_state_may_be_implicit": true,
  "state_fields": [
    "chemical_id",
    "component_masses",
    "total_mass",
    "density",
    "temperature",
    "charge",
    "energy",
    "optional_isotope_abundance_ppm",
    "isotope_binding",
    "loaded_exposure_ticks",
    "deterministic_exposure_seed"
  ],
  "evaluation_surfaces": [
    "machine_or_cloud_tick",
    "player_inventory_periodic_scan",
    "active_dropped_item_scan",
    "active_block_inventory_scan",
    "sealed_cell_evaluation"
  ],
  "active_holder_index": {
    "scope": "radioactive_dropped_items_and_loaded_block_inventories",
    "scheduling": "bounded_round_robin_budgeted_periodic_scan",
    "membership_updates": [
      "entity_join_leave",
      "chunk_load_unload",
      "block_entity_mutation"
    ],
    "player_inventory_scheduling": "direct_periodic_scan_every_40_ticks"
  },
  "decay_math": {
    "bulk_and_cell": "continuous_deterministic_mass_debit_with_explicit_daughter_and_mass_defect_heat",
    "loose_stack": "deterministic_loaded_exposure_probability_per_evaluation_window",
    "loaded_time_only": true,
    "unloaded_catchup": false
  },
  "excluded_features": {
    "global_world_or_inventory_scan": "not_implemented_by_design",
    "unloaded_decay_catchup": "not_implemented",
    "timing_wheel_or_priority_queue": "not_implemented",
    "declared_event_boundary_state_machine": "not_implemented",
    "magic_stabilization": "not_implemented",
    "reactor_machine_or_nuclear_energy_capability": "not_implemented_by_design",
    "full_upstream_isotope_catalog": "not_implemented_and_release_blocking"
  }
}
