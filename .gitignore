# Runtime binaries that Packwiz deliberately resolves from committed metadata live
# in `mods/`; bundled custom jars and curated resource/shader archives are source
# inputs and must be explicitly declared by the custom-mod inventory.
# Keep only disposable/downloaded installer output out of the worktree.
/forge-*-installer.jar
/forge-*-installer.jar.log
.idea/
tools/runtime-probe/.gradle/
tools/runtime-probe/build/
__pycache__/
**/__pycache__/
*.pyc
server-instance/
server-template/
generated/exports/
generated/exports-build40-*
generated/cache/
generated/evidence/
# Custom-mod source directories are owned source inputs.  Ignore their build and
# Gradle caches, not the sources themselves.
generated/custom-mod-sources/**/.gradle/
generated/custom-mod-sources/**/build/
